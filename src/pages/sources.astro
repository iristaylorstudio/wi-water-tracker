---
import Layout from '../layouts/Layout.astro';
import { loadData } from '../lib/loadData';
import { SOURCE_TYPE_LABELS } from '../lib/labels';
import { formatDate } from '../lib/format';

const sources = [...loadData().sources.values()].sort((a, b) =>
  (b.published ?? '').localeCompare(a.published ?? '') || a.title.localeCompare(b.title),
);
---

<Layout title="Sources" description="Every source cited on this site, with publisher, date and link.">
  <div class="prose">
    <h1>Sources</h1>
    <p>
      Every figure and event on this site comes from one of these sources. Newest first. "Accessed" is the date we
      last opened the source. An archived copy is a saved snapshot in case the original page changes or goes away.
    </p>
  </div>

  {
    sources.length === 0 ? (
      <p class="muted">No sources yet.</p>
    ) : (
      <ul class="source-list">
        {sources.map((s) => (
          <li>
            <a class="title" href={s.url}>
              {s.title}
            </a>
            <div class="meta">
              {s.publisher}. {SOURCE_TYPE_LABELS[s.type] ?? s.type}. Published {formatDate(s.published)}. Accessed{' '}
              {formatDate(s.accessed)}.
              {s.archived_url && (
                <>
                  {' '}
                  <a href={s.archived_url}>Archived copy</a>.
                </>
              )}
            </div>
            {s.reliability_note && <div class="note muted">{s.reliability_note}</div>}
          </li>
        ))}
      </ul>
    )
  }
</Layout>

<style>
  .source-list {
    list-style: none;
    padding: 0;
    margin: 1.5rem 0 0;
    max-width: 48rem;
  }
  .source-list li {
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--line);
  }
  .title {
    font-weight: 600;
  }
  .meta {
    font-size: 0.95rem;
  }
  .note {
    font-size: 0.9rem;
  }
</style>
