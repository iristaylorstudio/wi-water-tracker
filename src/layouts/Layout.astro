---
import { url } from '../lib/paths';

interface Props {
  title: string;
  description?: string;
}

const SITE_NAME = 'Wisconsin AI Infrastructure & Water Tracker';
const { title, description = 'Tracks data centers in Wisconsin and what is publicly known about their water use.' } =
  Astro.props;
const fullTitle = title === SITE_NAME ? title : `${title} | ${SITE_NAME}`;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{fullTitle}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="site-name" href={url('/')}>{SITE_NAME}</a>
      <nav aria-label="Main">
        <a href={url('/')}>Map</a>
        <a href={url('sources/')}>Sources</a>
        <a href={url('methodology/')}>Methodology</a>
        <a href={url('submit/')}>Send a tip</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <a href={url('privacy/')}>Privacy</a>
      <a href={url('methodology/')}>How confidence is computed</a>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --text: #1d2327;
    --muted: #5b646b;
    --line: #d9dee2;
    --bg: #ffffff;
    --bg-soft: #f4f6f7;
    --link: #1f5f8b;
    font-family: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
    line-height: 1.5;
    color: var(--text);
    background: var(--bg);
  }
  * {
    box-sizing: border-box;
  }
  body {
    margin: 0;
  }
  a {
    color: var(--link);
  }
  main {
    max-width: 72rem;
    margin: 0 auto;
    padding: 1.5rem 1rem 4rem;
  }
  h1 {
    font-size: 1.75rem;
    line-height: 1.2;
    margin: 0 0 0.5rem;
  }
  h2 {
    font-size: 1.25rem;
    margin: 2rem 0 0.75rem;
  }
  .muted {
    color: var(--muted);
  }
  .site-header {
    border-bottom: 1px solid var(--line);
    padding: 0.75rem 1rem;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
  }
  .site-name {
    font-weight: 600;
    color: var(--text);
    text-decoration: none;
  }
  .site-header nav,
  .site-footer {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    font-size: 0.95rem;
  }
  .site-footer {
    border-top: 1px solid var(--line);
    padding: 1rem;
    justify-content: center;
    font-size: 0.9rem;
  }
  .prose {
    max-width: 42rem;
  }
</style>
