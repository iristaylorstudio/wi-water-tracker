---
import { CONFIDENCE_COLORS, type Confidence } from '../lib/confidence';

interface Props {
  level: Confidence;
}

const { level } = Astro.props;
---

<span class="confidence-badge">
  <span class="dot" style={`background:${CONFIDENCE_COLORS[level]}`} aria-hidden="true"></span>
  {level}
</span>

<style>
  .confidence-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    white-space: nowrap;
  }
  .dot {
    width: 0.75em;
    height: 0.75em;
    border-radius: 50%;
    flex: none;
  }
</style>
